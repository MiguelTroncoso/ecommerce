          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Herencia: ProductoFisico <|- ProductoElectronica -->
        <mxCell id="rel_h_elect" style="endArrow=block;endFill=0;html=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" source="c_pelectronica" target="c_pfisico" parent="1">
          <mxGeometry relative="1" as="geometry" />
