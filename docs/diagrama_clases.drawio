        <!-- NOTA EXPLICATIVA POO -->
        <mxCell id="note_poo" value="&lt;b&gt;POLIMORFISMO DE ENTREGA:&lt;/b&gt;&lt;br&gt;Cada subclase de Producto resuelve &lt;i&gt;procesarEntrega()&lt;/i&gt; según su tipo:&lt;br&gt;• &lt;b&gt;Físico:&lt;/b&gt; Calcula flete y genera guía courier.&lt;br&gt;• &lt;b&gt;Digital:&lt;/b&gt; Envía link y licencia instantánea (flete $0).&lt;br&gt;• &lt;b&gt;Servicio:&lt;/b&gt; Agenda visita para fecha acordada.&lt;br&gt;&lt;br&gt;&lt;b&gt;INVARIANTE DE DESPACHO:&lt;/b&gt;&lt;br&gt;&lt;i&gt;Pedido.despachar()&lt;/i&gt; valida que &lt;i&gt;operador.puedeDespachar() == true&lt;/i&gt; Y &lt;i&gt;estadoPago == PAGADO&lt;/i&gt;." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#ffffcc;strokeColor=#d6b656;align=left;spacingLeft=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1000" y="870" width="550" height="150" as="geometry" />
        </mxCell>

