        <!-- Herencia: Trabajador <|- EncargadoBodega -->
        <mxCell id="rel_h_bodega" style="endArrow=block;endFill=0;html=1;exitX=0.5;exitY=0;entryX=0.3;entryY=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" source="c_bodega" target="c_trabajador" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Herencia: Trabajador <|- Administrador -->
        <mxCell id="rel_h_admin" style="endArrow=block;endFill=0;html=1;exitX=0.5;exitY=0;entryX=0.7;entryY=1;strokeColor=#333333;strokeWidth=1.5;" edge="1" source="c_admin" target="c_trabajador" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Dependencia / Uso: Pedido usa Trabajador -->
        <mxCell id="rel_pedido_trabajador" value="&amp;laquo;usa&amp;raquo; (despachar)" style="endArrow=open;dashed=1;html=1;exitX=0;exitY=0.8;entryX=1;entryY=0.3;strokeColor=#666666;strokeWidth=1.5;" edge="1" source="c_pedido" target="c_trabajador" parent="1">
